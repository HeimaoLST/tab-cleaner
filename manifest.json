{
  "manifest_version": 3,
  "name": "Tab Tidy (Rule Demo)",
  "version": "0.1.2",
  "description": "Rule-based demo: close temporary/duplicate tabs and group common sites.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "action": {
    "default_title": "Tab Tidy",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  }
}
